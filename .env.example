# Copy this file to .env.local. Values prefixed with NEXT_PUBLIC_ are included
# in the browser bundle, so never add API keys, credentials, signed URLs, or
# private reference assets here.

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8001
NEXT_PUBLIC_VIDEO_MODEL_ID=bytedance/seedance-2.0
NEXT_PUBLIC_IDENTITY_REFERENCE_PRODUCTION_ENABLED=false

# Audited public HTTPS references only, comma-separated, at most two.
# Keep empty for the current Seedance production path.
# NEXT_PUBLIC_INFLUENCER_REFERENCE_URLS=
